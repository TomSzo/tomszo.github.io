<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
	<category label="Belépés">
		<setting id="email" type="text" label="Email cím (Telekom-fiók)" default="" />
		<setting id="password" type="text" label="Jelszó" option="hidden" default="" />
		<setting type="lsep" label="Tartalék: refresh token a böngészőből (ha az automatikus belépés nem megy)" />
		<setting id="refresh_token" type="text" label="Refresh token (vagy a teljes visszairányítási URL)" default="" />
		<setting type="action" label="Munkamenet törlése (újra bejelentkezés)"
		         action="RunPlugin(plugin://plugin.video.telekomtvgo/?action=clearsession)" />
	</category>
	<category label="Menü">
		<setting id="show_now" type="bool" label="Élő TV: a most futó műsor kiírása" default="true" />
		<setting id="hide_radio" type="bool" label="Rádiócsatornák elrejtése" default="true" />
		<setting type="action" label="Gyorsítótár törlése (csatornák, műsorújság)"
		         action="RunPlugin(plugin://plugin.video.telekomtvgo/?action=clearcache)" />
	</category>
	<category label="Hibakeresés">
		<setting id="debug_dump" type="bool" label="Nyers API-válaszok mentése a profil-mappába (debug_*.json)" default="false" />
	</category>
</settings>
