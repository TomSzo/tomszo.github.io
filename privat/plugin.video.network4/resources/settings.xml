<settings>
	<category label="Belépés">
		<setting type="lsep" label="Ajánlott: böngészős sütik (a /login Cloudflare-védett)" />
		<setting id="cookie" type="text" label="Böngészős sütik (Cookie fejléc: név=érték; ...)" default="" />
		<setting id="cookie_file" type="file" label="VAGY süti-fájl (cookies.txt / JSON export)" default="" />
		<setting type="lsep" label="Tartalék: email/jelszó (Cloudflare-kihívásnál nem működik)" />
		<setting id="email" type="text" label="Email cím" default="" />
		<setting id="password" type="text" label="Jelszó" option="hidden" default="" />
		<setting id="cred_file" type="file" label="VAGY email/jelszó txt fájl (nincs gépelés)" default="" />
		<setting type="action" label="Munkamenet törlése (újra bejelentkezés)"
		         action="RunPlugin(plugin://plugin.video.network4/?action=clearsession)" />
		<setting id="base_url" type="text" label="Alap URL (csak domainváltáskor)"
		         default="https://www.network4.hu/" />
		<setting id="user_agent" type="text" label="Böngésző User-Agent (cf_clearance-nél a böngészőével EGYEZZEN)"
		         default="Mozilla/5.0 (Android 16; Mobile; rv:156.0) Gecko/156.0 Firefox/156.0" />
	</category>
	<category label="Lejátszás">
		<setting id="license_url" type="text" label="Widevine licenc URL (üres = automatikus / Uplynk)" default="" />
		<setting id="last_slug" type="text" label="Utoljára megnyitott link/slug" default="" />
	</category>
	<category label="Egyéb">
		<setting id="debug" type="bool" label="Hibakeresés: minden details oldal mentése" default="false" />
	</category>
</settings>
