<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="View_504_MediaList">
		<param name="bottom_offset">list_bottom_offset</param>
		<definition>
			<control type="group">
				<include>OpenClose_Right</include>
				<visible>Control.IsVisible(504)</visible>
				<include>Visible_Right</include>
				<include content="TS_List18_View_504_MediaList_Fixed" condition="Skin.HasSetting(remotemode)">
					<param name="bottom_offset" value="$PARAM[bottom_offset]" />
				</include>
				<include content="TS_List18_View_504_MediaList_Touch" condition="!Skin.HasSetting(remotemode)">
					<param name="bottom_offset" value="$PARAM[bottom_offset]" />
				</include>
			</control>
		</definition>
	</include>
</includes>
