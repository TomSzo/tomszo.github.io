     kártyarács (egy görgetési irány = akadásmentes húzás), alul fix menüsáv. -->
<includes>
	<variable name="AppTitleVar">
		<value condition="String.IsEqual(Window(home).Property(app_tab),movies)">$LOCALIZE[31974]</value>
		<value condition="String.IsEqual(Window(home).Property(app_tab),tvshows)">$LOCALIZE[31975]</value>
		<value condition="String.IsEqual(Window(home).Property(app_tab),addons)">$LOCALIZE[31976]</value>
		<value condition="String.IsEqual(Window(home).Property(app_tab),favourites)">$LOCALIZE[31977]</value>
		<value>$LOCALIZE[31973]</value>
	</variable>
	<variable name="AppFeedPath5000">
		<value condition="[String.IsEmpty(Window(home).Property(app_tab)) | String.IsEqual(Window(home).Property(app_tab),home)] + [String.IsEmpty(Window(home).Property(app_chip)) | String.IsEqual(Window(home).Property(app_chip),1)]">special://skin/playlists/inprogress_movies.xsp</value>
		<value condition="[String.IsEmpty(Window(home).Property(app_tab)) | String.IsEqual(Window(home).Property(app_tab),home)] + String.IsEqual(Window(home).Property(app_chip),2)">videodb://inprogresstvshows/</value>
		<value condition="[String.IsEmpty(Window(home).Property(app_tab)) | String.IsEqual(Window(home).Property(app_tab),home)] + String.IsEqual(Window(home).Property(app_chip),3)">videodb://recentlyaddedmovies/</value>
		<value condition="[String.IsEmpty(Window(home).Property(app_tab)) | String.IsEqual(Window(home).Property(app_tab),home)] + String.IsEqual(Window(home).Property(app_chip),4)">videodb://recentlyaddedepisodes/</value>
		<value condition="String.IsEqual(Window(home).Property(app_tab),movies) + [String.IsEmpty(Window(home).Property(app_chip)) | String.IsEqual(Window(home).Property(app_chip),1)]">videodb://movies/titles/</value>
		<value condition="String.IsEqual(Window(home).Property(app_tab),movies) + String.IsEqual(Window(home).Property(app_chip),2)">special://skin/playlists/unwatched_movies.xsp</value>
		<value condition="String.IsEqual(Window(home).Property(app_tab),movies) + String.IsEqual(Window(home).Property(app_chip),3)">videodb://recentlyaddedmovies/</value>
		<value condition="String.IsEqual(Window(home).Property(app_tab),movies) + String.IsEqual(Window(home).Property(app_chip),4)">videodb://movies/sets/</value>
		<value condition="String.IsEqual(Window(home).Property(app_tab),tvshows) + [String.IsEmpty(Window(home).Property(app_chip)) | String.IsEqual(Window(home).Property(app_chip),1)]">videodb://tvshows/titles/</value>
		<value condition="String.IsEqual(Window(home).Property(app_tab),tvshows) + String.IsEqual(Window(home).Property(app_chip),2)">videodb://inprogresstvshows/</value>
		<value condition="String.IsEqual(Window(home).Property(app_tab),tvshows) + String.IsEqual(Window(home).Property(app_chip),3)">videodb://recentlyaddedepisodes/</value>
		<value condition="String.IsEqual(Window(home).Property(app_tab),tvshows) + String.IsEqual(Window(home).Property(app_chip),4)">special://skin/playlists/unwatched_tvshows.xsp</value>
		<value condition="String.IsEqual(Window(home).Property(app_tab),addons) + [String.IsEmpty(Window(home).Property(app_chip)) | String.IsEqual(Window(home).Property(app_chip),1)]">addons://sources/video/</value>
		<value condition="String.IsEqual(Window(home).Property(app_tab),favourites) + [String.IsEmpty(Window(home).Property(app_chip)) | String.IsEqual(Window(home).Property(app_chip),1)]">favourites://</value>
	</variable>
	<variable name="AppFeedPath5001">
		<value condition="String.IsEqual(Window(home).Property(app_tab),addons) + String.IsEqual(Window(home).Property(app_chip),2)">addons://sources/executable/</value>
	</variable>
	<variable name="AppFeedPath5002">
		<value condition="String.IsEqual(Window(home).Property(app_tab),addons) + String.IsEqual(Window(home).Property(app_chip),3)">addons://sources/audio/</value>
	</variable>
	<variable name="AppCardArtVar">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>
	<variable name="AppCardLabelVar">
		<value condition="!String.IsEmpty(ListItem.TVShowTitle) + String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.TVShowTitle]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="AppCardLabel2Var">
		<value condition="String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.Season,S,]$INFO[ListItem.Episode,E,]$INFO[ListItem.Title, · ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow)">$INFO[ListItem.Year]$INFO[ListItem.Property(UnWatchedEpisodes), · ,]</value>
		<value>$INFO[ListItem.Year]</value>
