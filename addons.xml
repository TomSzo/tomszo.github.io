<?xml version="1.0" encoding="UTF-8"?>
<addons>

<addon id="repository.tomszo" name="TomSzo Repository" version="1.0.3" provider-name="TomSzo">
    <requires>
        <import addon="xbmc.addon" version="12.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository" name="TomSzo Repository">
        <dir>
            <info compressed="false">https://tomszo.github.io/addons.xml</info>
            <checksum>https://tomszo.github.io/addons.xml.md5</checksum>
            <datadir zip="true">https://tomszo.github.io/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">TomSzo Kodi Repository</summary>
        <summary lang="hu">TomSzo Kodi Tároló</summary>
        <description lang="en">A personal Kodi repository by TomSzo. Contains carefully selected third-party repositories and useful modules. Included: ElementumOrg, jurialmunkey, MovieShark, Addons4Kodi, service.autosub. WARNING: BETA repository. Use at your own risk.</description>
        <description lang="hu">TomSzo személyes Kodi tárolója. Tartalmazza: ElementumOrg, jurialmunkey, MovieShark, Addons4Kodi, service.autosub. FIGYELEM: BÉTA tároló. Csak saját felelősségre!</description>
        <news>
v1.0.3 (2026-09-20) - BÉTA
- Frissítve: repository.jurialmunkey 3.4 -> 3.5
- Eltávolítva: repository.bingie
- Eltávolítva: skin.estuary.modv2
- Eltávolítva: script.module.pvr.artwork
- Eltávolítva: script.module.animated_artwork
- Eltávolítva: resource.images.moviegenreicons.estuarymod
- Tároló letisztítva: 6 addon maradt

v1.0.2 (2026-04-05) - BÉTA
- Fix: repository.bingie frissítve Kodi 22 kompatibilis verzióra
- Fix: service.autosub zip fájlnév javítva
- Fix: addons.xml BOM encoding hiba javítva
- Új: Auto addon frissítés bekapcsolva
- Új: Magyar nyelv támogatás

v1.0.1 (2026-04-05) - BÉTA
- Hozzáadva: repository.addons4kodi
- Hozzáadva: service.autosub

v1.0.0 (2026-04-04) - BÉTA
- Kezdeti kiadás
- Hozzáadva: repository.elementumorg
